    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/dompurify": "^3.2.0",
    "@vitest/browser-playwright": "^5.0.5",
    "browserslist": "^4.29.3",
    "clsx": "^2.1.1",
    "directus-sdk-typegen": "^0.2.1",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "markdown-it": "^15.0.3",
    "oxfmt": "^0.72.0",
