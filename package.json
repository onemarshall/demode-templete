{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#scripts/actions": "./src/assets/scripts/actions/index.ts",
    "#scripts/actions/*": "./src/assets/scripts/actions/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@resvg/resvg-wasm": "^2.6.2",
