{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#scripts/actions": "./src/assets/scripts/actions/index.ts",
    "#scripts/actions/*": "./src/assets/scripts/actions/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "node scripts/check-module-boundaries.mjs && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "check:modules": "node scripts/check-module-boundaries.mjs",
    "strategy:worker:build": "node scripts/strategy/build-worker.mjs",
    "strategy:resources": "node scripts/strategy/build-resources.mjs"
  },
