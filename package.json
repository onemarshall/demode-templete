    "@sveltinio/essentials": "^0.7.9",
    "@sveltinio/media-content": "^0.4.3",
    "bits-ui": "^2.19.5",
    "cursix": "^1.1.4",
    "formsnap": "^2.0.1",
    "gsap": "^3.15.0",
    "number-flow": "^0.6.2",
    "p-queue": "^9.3.5",
    "runed": "^0.37.1",
    "sveltekit-superforms": "^3.0.0",
    "tooltip": "^1.6.1",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@directus/sdk": "^26.0.0",
    "@directus/visual-editing": "^2.1.0",
