
#################################################
# Application Configuration
#################################################

# Core app
PUBLIC_APP_NAME="example studio"
PUBLIC_SITE_URL=PUBLIC_SITE_URL
PUBLIC_ENV_MODE=development
NODE_ENV=development
PUBLIC_AUTH_DEBUG_MODE=false
AUTH_DEBUG_MODE=false
AUTH_MCP_PLUGIN=true
APP_LOGGER_DISABLED=false
ENABLE_SECURITY_ANALYSIS=false
BETTER_AUTH_SECRET=BETTER_AUTH_SECRET
# OAuth Proxy shared secret — must be IDENTICAL on every environment that
# participates in the proxy flow (production, preview, localhost).
OAUTH_PROXY_SECRET=OAUTH_PROXY_SECRET
BETTER_DATABASE_URL=   
PUBLIC_BETTER_AUTH_URL= 
PUBLIC_AUTH_CALLBACK_URL= 
PUBLIC_AUTH_SESSION_TOKEN_EXPIRES_IN=7d
BIGDATACLOUD_API_KEY=BIGDATACLOUD_API_KEY

#################################################
# Plugin Toggles (server-side)
#################################################
AUTH_PASSKEYS_PLUGIN=true
AUTH_MAGIC_LINK_PLUGIN=true
AUTH_ADMIN_PLUGIN=true
AUTH_EMAIL_OTP_PLUGIN=true
AUTH_LAST_LOGIN_METHOD_PLUGIN=false
AUTH_RATE_LIMIT_PLUGIN=true
AUTH_FRAUD_DETECTION_PLUGIN=false
AUTH_GEO_INTELLIGENCE_PLUGIN=true
AUTH_ABUSE_PROTECTION_PLUGIN=true
AUTH_SECURITY_ANALYTICS_PLUGIN=true
AUTH_OAUTH_PROXY_PLUGIN=true

#################################################
# Plugin Toggles (public/client)
#################################################
PUBLIC_AUTH_SOCIAL_LOGINS_ENABLED=true
PUBLIC_AUTH_PASSKEYS_PLUGIN=true
PUBLIC_AUTH_MAGIC_LINK_PLUGIN=true
PUBLIC_AUTH_ADMIN_PLUGIN=true
PUBLIC_AUTH_LAST_LOGIN_METHOD_PLUGIN=false
PUBLIC_AUTH_EMAIL_OTP_PLUGIN=true
PUBLIC_AUTH_SIWE_PLUGIN=false

#################################################
# Plugin Settings
#################################################

# Passkeys / WebAuthn
# The RP ID must be a registrable domain suffix of the origin the browser is
# served from (e.g. "iamstudios.cc" for "https://auth.iamstudios.cc"), and
# "localhost" when developing on http://localhost:<port>. When it is left
# empty it is derived from PUBLIC_BETTER_AUTH_URL / PUBLIC_SITE_URL.
PUBLIC_AUTH_PASSKEY_RP_NAME="example studio"
PUBLIC_AUTH_PASSKEY_RPID=PUBLIC_AUTH_PASSKEY_RPID
# Comma separated list of allowed origins. Leave empty to accept the origin
# of the incoming request.
PUBLIC_AUTH_PASSKEY_ORIGIN=PUBLIC_AUTH_PASSKEY_ORIGIN
PUBLIC_AUTH_PASSKEY_ATTACHMENT=platform         # platform | cross-platform (optional)
PUBLIC_AUTH_PASSKEY_RESIDENT_KEY=preferred    # required | preferred | discouraged
PUBLIC_AUTH_PASSKEY_USER_VERIFICATION=preferred  # required | preferred | discouraged

# 2FA
AUTH_2FA_PLUGIN=true
PUBLIC_AUTH_2FA_PLUGIN=true
PUBLIC_AUTH_2FA_ISSUER="example studio"
AUTH_2FA_ISSUER=AUTH_2FA_ISSUER            
AUTH_2FA_SKIP_VERIFICATION_ON_ENABLE=false
AUTH_2FA_TOTP_PERIOD=30
AUTH_2FA_TOTP_DIGITS=6
AUTH_2FA_OTP_PERIOD_MINUTES=3

# SIWE (Sign in with Ethereum) + WalletConnect
AUTH_SIWE_ENABLED=false
SIWE_DOMAIN=your-domain-here
SIWE_EMAIL_DOMAIN=your-domain-here
SIWE_ANONYMOUS=false
SIWE_RPC_URL="https://eth.llamarpc.com"
SIWE_ENABLE_ENS_LOOKUP=false
PUBLIC_WALLETCONNECT_ID=52f50011241f55613b142d2e4ac652e1

# Magic link
AUTH_MAGIC_LINK_EXPIRES_IN=300
AUTH_MAGIC_LINK_DISABLE_SIGNUP=false

# Email OTP
AUTH_EMAIL_OTP_OVERRIDE_VERIFICATION=false
AUTH_EMAIL_OTP_SEND_ON_SIGNUP=false
AUTH_EMAIL_OTP_DISABLE_SIGNUP=false
AUTH_EMAIL_OTP_LENGTH=6
AUTH_EMAIL_OTP_EXPIRES_IN=300
AUTH_EMAIL_OTP_ALLOWED_ATTEMPTS=3
AUTH_EMAIL_OTP_STORE_STRATEGY=plain                           # plain | hashed | encrypted

# Admin
AUTH_ADMIN_DEFAULT_ROLE=user
ADMIN_ROLES=["admin","moderator"]
AUTH_ADMIN_USER_IDS=["user-id-1","user-id-2"]                # optional
AUTH_ADMIN_IMPERSONATION_SESSION_DURATION=3600
AUTH_ADMIN_DEFAULT_BAN_REASON="No reason"
AUTH_ADMIN_DEFAULT_BAN_EXPIRES_IN=3600     # seconds, optional

# Session management
PUBLIC_AUTH_SESSION_MANAGEMENT_ENABLED=true
PUBLIC_AUTH_MAX_SESSIONS=5

# Email verification / reset / passwordless
PUBLIC_AUTH_EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_AUTH_EMAIL_VERIFICATION_EXPIRES_IN=24h
PUBLIC_AUTH_PASSWORD_RESET_ENABLED=true
PUBLIC_AUTH_PASSWORD_RESET_EXPIRES_IN=1h
PUBLIC_AUTH_PASSWORDLESS_ENABLED=false

# Account management
PUBLIC_AUTH_ACCOUNT_MANAGEMENT_ENABLED=true
PUBLIC_AUTH_DELETE_ACCOUNT_ENABLED=false
AUTH_ADMIN_ENABLED=false
AUTH_LAST_LOGIN_METHOD_ENABLED=true
AUTH_LAST_LOGIN_METHOD_STORE_DB=true
AUTH_ONE_TIME_TOKEN_ENABLED=false

#################################################
# Payment & Subscriptions
#################################################

# API Key from Creem dashboard (https://creem.io/dashboard/developers)
CREEM_API_KEY=your-creem-api-key
# Webhook signing secret (optional - enables webhook processing)
CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
# Test mode (default: true for development)
CREEM_TEST_MODE=true
# Persist subscriptions to database (default: true)
CREEM_PERSIST_SUBSCRIPTIONS=true
# Default redirect URL after successful checkout
CREEM_DEFAULT_SUCCESS_URL=/dashboard
# Public flag to enable Creem client-side (default: false)
PUBLIC_CREEM_ENABLED=true

#################################################
# Social Authentication Providers
#################################################
AUTH_SOCIAL_LOGIN_ENABLED=true

# GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
PUBLIC_AUTH_GITHUB_ENABLED=false

# Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PUBLIC_AUTH_GOOGLE_ENABLED=false

# Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
PUBLIC_AUTH_DISCORD_ENABLED=false

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
PUBLIC_AUTH_LINKEDIN_ENABLED=false

# Twitter / X
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
PUBLIC_AUTH_TWITTER_ENABLED=false

#################################################
# Provider Selection Summary
#################################################
EMAIL_PROVIDER=usesend            # usesend | resend | sendgrid | smtp | mock
STORAGE_PROVIDER=local            # local | s3 | cloudinary | mock  — controls UPLOADED FILE storage
CMS_PROVIDER=directus             # directus | strapi | payload | sanity | temple | none
PUBLIC_CMS_PROVIDER=directus 

#################################################
# Infrastructure & Database
#################################################

# -----------------------------------------------
# Redis (optional)
# Leave REDIS_URL blank to run without Redis.
# -----------------------------------------------
REDIS_URL=redis://default:[REDIS_PASSWORD]@000.000.00.000:0000
REDIS_HOST=000.000.00.000
REDIS_PORT=0000
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS=false

# -----------------------------------------------
# Security KV Storage Backend
# Controls: rate limiting, IP blocking, CAPTCHA bypass tokens, device trust
# NOTE: this is SEPARATE from STORAGE_PROVIDER (which is for uploaded files)
#
# Auto-selection order (when SECURITY_STORAGE is not set):
#   1. Redis   — if REDIS_URL is set          ← current config uses this
#   2. Postgres — if PG_KV_STORE=true  (tables auto-created on first use)
#   3. Memory  — default fallback (dev only, not persisted across restarts)
#
# Override auto-selection:
#   SECURITY_STORAGE=redis    — force Redis (REDIS_URL must be set)
#   SECURITY_STORAGE=postgres — force Postgres KV tables
#   SECURITY_STORAGE=memory   — force in-memory (even if REDIS_URL is present)
# -----------------------------------------------
SECURITY_STORAGE=postgres                 # redis | postgres | memory  (leave blank for auto)
PG_KV_STORE=true                 # set true to use Postgres as security KV store

# -----------------------------------------------
# Security Analytics Event Store
# Controls where security analytics events are buffered.
# Independent of SECURITY_STORAGE above.
# -----------------------------------------------
SECURITY_ANALYTICS_STORE_PROVIDER=redis   # redis | memory
SECURITY_ANALYTICS_REDIS_KEY_PREFIX=security:analytics:
SECURITY_ANALYTICS_REDIS_MAX_EVENTS=10000
SECURITY_ANALYTICS_REDIS_NAME=SecurityAnalyticsEventStore


# CAPTCHA / Security extras
CAPTCHA=true
PUBLIC_TRUSTED_IPS=000.000.00.000,000.000.00.000
PUBLIC_CAP_KEY=8335e7c118
PUBLIC_CAP_ENDPOINT=PUBLIC_CAP_ENDPOINT    
CAP_SECRET=CAP_SECRET

#################################################
# Email Services
#################################################

# EMAIL_API_KEY is provider-agnostic (SendGrid, Resend, UseSend)
EMAIL_PROVIDER_URL=EMAIL_PROVIDER_URL
EMAIL_FROM=no-reply@transactional.email
EMAIL_FROM_NAME="example studios"
EMAIL_REPLY_TO=no-reply@transactional.email
EMAIL_TO=apps@email.com
EMAIL_DEBUG=true

# UseSend
EMAIL_USESEND_API_KEY=EMAIL_USESEND_API_KEY

# SendGrid
EMAIL_SENDGRID_API_KEY=EMAIL_SENDGRID_API_KEY

# Resend
EMAIL_RESEND_API_KEY=EMAIL_RESEND_API_KEY
RESEND_DOMAIN=RESEND_DOMAIN

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

#################################################
# CMS Configuration
#################################################
# CMS_API_URL is used server-side; PUBLIC_CMS_URL is baked into asset URLs the
# browser fetches directly, so it must be reachable from the browser and use the
# same scheme as the app (HTTPS in production) or the assets are blocked as mixed content.
CMS_API_URL=https://cms.iamstudios.cc
PUBLIC_CMS_URL=https://cms.iamstudios.cc

# Directus
DIRECTUS_ADMIN_TOKEN=DIRECTUS_ADMIN_TOKEN   
DIRECTUS_DEFAULT_ROLE_ID=DIRECTUS_DEFAULT_ROLE_ID

# Strapi
STRAPI_API_TOKEN=STRAPI_API_TOKEN
STRAPI_API_VERSION=STRAPI_API_VERSION

# Payload
PAYLOAD_API_TOKEN=PAYLOAD_API_TOKEN
PAYLOAD_USERS_COLLECTION=PAYLOAD_USERS_COLLECTION
PAYLOAD_MEDIA_COLLECTION=
PAYLOAD_AVATAR_FIELD=

# Sanity
SANITY_API_TOKEN=SANITY_API_TOKEN
SANITY_PROJECT_ID=SANITY_PROJECT_ID
SANITY_DATASET=SANITY_DATASET
SANITY_API_VERSION=SANITY_API_VERSION

#################################################
# Storage Configuration
#################################################
PUBLIC_STORAGE_TYPE=local         # local | s3 | cloudinary
STORAGE_UPLOAD_DIR=./uploads
STORAGE_BASE_URL=
LOCAL_STORAGE_PATH=./uploads

# S3
S3_ACCESS_KEY_ID=S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=S3_SECRET_ACCESS_KEY
S3_BUCKET=S3_BUCKET
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
PUBLIC_S3_BUCKET=
PUBLIC_S3_REGION=us-east-1

# Cloudinary
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
CLOUDINARY_FOLDER=uploads
PUBLIC_CLOUDINARY_CLOUD_NAME=
