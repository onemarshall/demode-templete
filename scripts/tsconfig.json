{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"$lib/*": ["../src/lib/*"],
			"$lib": ["../src/lib"]
		}
	},
	"include": ["*.ts"],
	"exclude": ["node_modules"]
}
