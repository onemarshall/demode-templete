{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demode-templete",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "AUTH_2FA_PLUGIN": "true",
    "AUTH_ABUSE_PROTECTION_PLUGIN": "true",
    "AUTH_ADMIN_PLUGIN": "true",
    "AUTH_ADMIN_USER_IDS": "[\"user-id-1\",\"user-id-2\"]",
    "AUTH_EMAIL_OTP_PLUGIN": "true",
    "AUTH_GEO_INTELLIGENCE_PLUGIN": "true",
    "AUTH_MAGIC_LINK_PLUGIN": "true",
    "AUTH_OAUTH_PROXY_PLUGIN": "true",
    "AUTH_PASSKEYS_PLUGIN": "true",
    "AUTH_RATE_LIMIT_PLUGIN": "true",
    "AUTH_SECURITY_ANALYTICS_PLUGIN": "true",
    "CAPTCHA": "true",
    "CMS_PROVIDER": "none",
    "EMAIL_DEBUG": "true",
    "EMAIL_FROM": "no-reply@transactional.iamstudios.cc",
    "EMAIL_FROM_NAME": "IAM Studios",
    "EMAIL_PROVIDER": "usesend",
    "EMAIL_PROVIDER_URL": "https://usesend.iamstudios.cc",
    "EMAIL_REPLY_TO": "no-reply@transactional.iamstudios.cc",
    "EMAIL_TO": "apps@iamstudios.cc",
    "PG_KV_STORE": "true",
    "PUBLIC_APP_NAME": "IAM Studio",
    "PUBLIC_AUTH_2FA_ISSUER": "IAM Studio",
    "PUBLIC_AUTH_2FA_PLUGIN": "true",
    "PUBLIC_AUTH_ADMIN_PLUGIN": "true",
    "PUBLIC_AUTH_CALLBACK_URL": "https://auth.iamstudios.cc",
    "PUBLIC_AUTH_EMAIL_OTP_PLUGIN": "true",
    "PUBLIC_AUTH_LAST_LOGIN_METHOD_PLUGIN": "false",
    "PUBLIC_AUTH_MAGIC_LINK_PLUGIN": "true",
    "PUBLIC_AUTH_PASSKEY_ATTACHMENT": "platform",
    "PUBLIC_AUTH_PASSKEY_RP_NAME": "IAM Studio",
    "PUBLIC_AUTH_PASSKEYS_PLUGIN": "true",
    "PUBLIC_AUTH_SOCIAL_LOGINS_ENABLED": "true",
    "PUBLIC_BETTER_AUTH_URL": "https://auth.iamstudios.cc",
    "PUBLIC_CAP_ENDPOINT": "https://cap.iamstudios.cc/",
    "PUBLIC_CAP_KEY": "8335e7c118",
    // Off until the VAT position is established. Checkout and fulfilment are
    // implemented and one-time; see src/lib/app/vat.server.ts for the four
    // conditions that must hold before this is set to "true".
    "PUBLIC_STRIPE_ENABLED": "false",
    "PUBLIC_ENV_MODE": "production",
    "PUBLIC_SITE_URL": "https://auth.iamstudios.cc",
    "PUBLIC_TRUSTED_IPS": "141.147.76.172,127.0.0.1,192.168.1.10",
    "REDIS_HOST": "sites-betterauth-fmrvqy",
    "REDIS_PORT": "8099",
    "SECURITY_STORAGE": "postgres",
    "STRIPE_PRICE_SIGNAL": "price_1UVtfyHQny0VaIlgvDJZ8V3I",
    "STRIPE_PRICE_GAP": "price_1UVtg2HQny0VaIlgLKXo2Eng",
    "STRIPE_PRICE_DIRECTION": "price_1UVtg3HQny0VaIlgxVLSk0Ol",
    "STRIPE_PRICE_FULL_DIAGNOSTIC": "price_1UVtg3HQny0VaIlg6UWIIJfP",
    "STRIPE_PRICE_STRATEGY": "price_1UVtg4HQny0VaIlgu02dcNQg",
    "STRIPE_PRICE_101_BETTER_WAYS": "price_1UVtg8HQny0VaIlg9zOuYUcR",
    "STRIPE_PRICE_EVERYTHING_WORKS": "price_1UVtg9HQny0VaIlgHTjKoTpA",
